@* Ten-frames (rekenrek-style 2 × 5 grids), filled row by row like at school.
   First = cells in the first colour, Second = cells after it in the second colour
   (8 + 5 → 8 orange, then 2 gold to finish the ten, 3 gold in the next frame).
   Gone = the last N filled cells are crossed out (subtraction). *@

<div class="tenframes">
    @for (int f = 0; f < FrameCount; f++)
    {
        <div class="tenframe">
            @for (int c = 0; c < 10; c++)
            {
                var n = f * 10 + c;                 // 0-based cell index across frames
                var kind = n < First ? "tf-a" : n < First + Second ? "tf-b" : "tf-empty";
                var gone = Gone > 0 && n >= First + Second - Gone && n < First + Second;
                <span class="tf-cell @kind @(gone ? "tf-gone" : "")"></span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int First { get; set; }
    [Parameter] public int Second { get; set; }
    [Parameter] public int Gone { get; set; }
    /// <summary>Show at least this many frames (e.g. 2 so a sum that crosses ten has room).</summary>
    [Parameter] public int MinFrames { get; set; } = 1;

    private int FrameCount => Math.Max(MinFrames, (First + Second + 9) / 10);
}
