@inject LanguageService Lang
@inject IJSRuntime JS

<div class="settings-panel">
    @if (open)
    {
        <div class="settings-backdrop" @onclick="Close"></div>
    }
    <button class="settings-gear-btn" @onclick="Toggle" title="Settings">⚙️</button>
    @if (open)
    {
        <div class="settings-dropdown">

            @* ── Language ── *@
            <div class="settings-item">
                <span class="settings-item-label">Taal / Language</span>
                <div class="lang-toggle">
                    <button class="lang-btn @(Lang.IsEnglish ? "lang-active" : "")" @onclick='() => PickLang("en")'>EN</button>
                    <button class="lang-btn @(!Lang.IsEnglish ? "lang-active" : "")" @onclick='() => PickLang("nl")'>NL</button>
                </div>
            </div>

            <hr class="settings-divider" />

            @* ── Voice ── *@
            <div class="settings-item settings-item-col">
                <span class="settings-item-label">Stem / Voice</span>
                @if (voices is null)
                {
                    <span class="voice-note">…</span>
                }
                else if (voices.Count == 0)
                {
                    <span class="voice-note">@(Lang.IsEnglish ? "This browser has no English voice." : "Deze browser heeft geen Nederlandse stem.")</span>
                }
                else
                {
                    <div class="voice-row">
                        <select class="voice-select" value="@voiceId" @onchange="PickVoice">
                            <option value="">@(Lang.IsEnglish ? "Automatic (best)" : "Automatisch (beste)")</option>
                            @foreach (var v in voices)
                            {
                                <option value="@v.Id">@v.Name</option>
                            }
                        </select>
                        <button class="voice-test" title="Test" @onclick="TestVoice">🔊</button>
                    </div>
                }
            </div>

            <hr class="settings-divider" />

            @* ── Theme color ── *@
            <div class="settings-item settings-item-col">
                <span class="settings-item-label">Kleur / Color</span>
                <div class="theme-presets">
                    @foreach (var (_, hex) in Presets)
                    {
                        var h = hex;
                        <button class="theme-dot @(currentColor == h ? "theme-dot-active" : "")"
                                style="background: @h"
                                @onclick="() => PickColor(h)">
                        </button>
                    }
                    <input type="color" class="theme-custom"
                           value="@currentColor"
                           @oninput="OnCustomColor" />
                </div>
            </div>

        </div>
    }
</div>

@code {
    private bool   open;
    private string currentColor = "#c84010";

    private static readonly (string Name, string Hex)[] Presets =
    [
        ("Orange", "#c84010"),
        ("Red",    "#c82828"),
        ("Pink",   "#d44080"),
        ("Purple", "#8040c8"),
        ("Blue",   "#2060c8"),
        ("Teal",   "#108890"),
        ("Green",  "#208850"),
        ("Yellow", "#b88010"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedLang = await JS.InvokeAsync<string?>("getSavedLang");
            if (savedLang != null) Lang.Set(savedLang);

            var saved = await JS.InvokeAsync<string?>("getSavedTheme");
            if (saved != null)
            {
                currentColor = saved;
                await JS.InvokeVoidAsync("applyTheme", saved);
                StateHasChanged();
            }
        }
    }

    private List<VoiceInfo>? voices;
    private string voiceId = "";

    public record VoiceInfo(string Id, string Name, string Lang, bool Local);

    private async Task Toggle()
    {
        open = !open;
        if (open) await LoadVoices();
    }

    private async Task LoadVoices()
    {
        voices = null;
        StateHasChanged();
        voices = await JS.InvokeAsync<List<VoiceInfo>>("getVoiceList", Lang.LangCode);
        voiceId = await JS.InvokeAsync<string>("getVoiceChoice", Lang.LangCode);
        if (voiceId != "" && !voices.Any(v => v.Id == voiceId)) voiceId = "";
    }

    private async Task PickVoice(ChangeEventArgs e)
    {
        voiceId = e.Value?.ToString() ?? "";
        await JS.InvokeVoidAsync("setVoiceChoice", Lang.LangCode, voiceId);
        await TestVoice();
    }

    private Task TestVoice()
        => JS.InvokeVoidAsync("previewVoice", Lang.LangCode, voiceId,
               Lang.IsEnglish ? "Hello! Twenty-three plus ten is thirty-three." : "Hallo! Drieëntwintig plus tien is drieëndertig.").AsTask();

    private void Close()  => open = false;

    private async Task PickLang(string lang)
    {
        Lang.Set(lang);
        await JS.InvokeVoidAsync("saveLang", lang);
        await LoadVoices();     // the voice list depends on the language
    }

    private async Task PickColor(string hex)
    {
        currentColor = hex;
        await JS.InvokeVoidAsync("saveTheme", hex);
        await JS.InvokeVoidAsync("applyTheme", hex);
    }

    private async Task OnCustomColor(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString();
        if (!string.IsNullOrEmpty(hex))
            await PickColor(hex);
    }
}
