@page "/quiz"
@inject IJSRuntime JS
@inject LanguageService Lang
@inject StarService Stars
@implements IDisposable

<PageTitle>@Strings.NavQuiz(Lang.Current) – TinyTutor</PageTitle>

<PageHeader Title="@Strings.QuizTitle(Lang.Current)">
    <Action>
        <button class="quiz-cfg-btn"
                @onclick="() => showSettings = !showSettings">
            @(showSettings ? "✕" : "⚙️")
        </button>
    </Action>
</PageHeader>

<div class="quiz-status-row">
    <span class="current-mode-label">@ModeLabel(currentMode)</span>
    <span class="level-badge" title="@Strings.QuizLevelHint(Lang.Current)">
        @Strings.QuizLevel(Lang.Current, level)
        @if (level < MaxLevel)
        {
            <span class="level-pips">
                @for (int i = 0; i < LevelUpRun; i++)
                {
                    <span class="pip @(i < levelRun ? "pip-on" : "")"></span>
                }
            </span>
        }
    </span>
</div>

@if (levelUpShown)
{
    <div class="level-up-banner">🚀 @Strings.QuizLevelUp(Lang.Current, level)</div>
}

@* ── Collapsible config (modes + auto-advance) ─────────────── *@
<div class="quiz-config @(showSettings ? "cfg-open" : "")">
    <div class="quiz-modes">
        @foreach (var m in AllModes)
        {
            var mode = m;
            var enabled = enabledModes.Contains(mode);
            var isOnly = enabledModes.Count == 1 && enabled;
            <button class="mode-btn @(enabled ? "mode-active" : "mode-off") @(isOnly ? "mode-only" : "") @(LevelModes(level).Contains(mode) ? "" : "mode-not-level")"
                    title="@(LevelModes(level).Contains(mode) ? "" : Strings.QuizModeNotThisLevel(Lang.Current))"
                    @onclick="() => ToggleMode(mode)"
                    disabled="@isOnly">
                @ModeLabel(mode)
            </button>
        }
    </div>

    <div class="quiz-settings">
        <span class="settings-label">@Strings.QuizAutoNext(Lang.Current)</span>
        <div class="delay-options">
            @foreach (var (label, secs) in DelayOptions)
            {
                var s = secs;
                <button class="delay-btn @(autoAdvanceSeconds == s ? "delay-active" : "")"
                        @onclick="() => SetDelay(s)">
                    @label
                </button>
            }
        </div>
    </div>
</div>

@* ── Question ─────────────────────────────────────────────── *@
<div class="quiz-question">
    @if (currentMode == QuizMode.Word)
    {
        <div class="quiz-word">@NumberHelper.GetDisplayWord(targetNumber,
                    Lang.Current)</div>
            <TtButton Variant="icon"
                      OnClick="HearQuestion">🔊</TtButton>
        }
    else if (currentMode == QuizMode.Count)
        {
            <p class="quiz-question-text">@QuestionText</p>
            <div class="quiz-dots-box">
                <div class="quiz-dots">
                    @for (int i = 0; i < targetNumber; i++)
                    {
                        <div class="dot-circle"></div>
                    }
                </div>
            </div>
        }
        else if ((currentMode == QuizMode.Add || currentMode == QuizMode.Subtract) && Math.Max(questionNum, targetNumber) > 20)
        {
            @* Too many to draw as dots (30 + 40, 47 − 3): show the sum as numbers. *@
            <p class="quiz-question-text">@QuestionText</p>
            <div class="quiz-sequence">
                <div class="sequence-box seq-given">@questionNum</div>
                <span class="sum-op">@(currentMode == QuizMode.Add ? "+" : "−")</span>
                <div class="sequence-box seq-given">@questionNum2</div>
                <span class="sum-op">=</span>
                <div class="sequence-box seq-blank">?</div>
            </div>
            <TtButton Variant="icon" OnClick="HearQuestion">🔊</TtButton>
        }
        else if (currentMode == QuizMode.Add || currentMode == QuizMode.Subtract)
        {
            <p class="quiz-question-text">@QuestionText</p>
            <div class="quiz-sequence">
                <div class="sequence-box seq-given">@questionNum</div>
                <span class="sum-op">@(currentMode == QuizMode.Add ? "+" : "−")</span>
                <div class="sequence-box seq-given">@questionNum2</div>
                <span class="sum-op">=</span>
                <div class="sequence-box @(solved ? "seq-given" : "seq-blank")">@(solved ? targetNumber : "?")</div>
            </div>
            @if (currentMode == QuizMode.Add)
            {
                @* 8 + 5: eight orange, then gold finishes the ten and spills into the next frame *@
                <TenFrames First="questionNum" Second="questionNum2" MinFrames="@(questionNum + questionNum2 > 10 ? 2 : 1)" />
            }
            else
            {
                <TenFrames First="questionNum" Gone="questionNum2" />
            }
            <TtButton Variant="icon" OnClick="HearQuestion">🔊</TtButton>
        }
        else if (currentMode == QuizMode.MakeTen)
        {
            <p class="quiz-question-text">@QuestionText</p>
            <div class="quiz-sequence">
                <div class="sequence-box seq-given">@questionNum</div>
                <span class="sum-op">+</span>
                <div class="sequence-box @(solved ? "seq-given" : "seq-blank")">@(solved ? targetNumber : "?")</div>
                <span class="sum-op">=</span>
                <span class="sum-result">10</span>
            </div>
            <TenFrames First="questionNum" Second="@(solved ? targetNumber : 0)" />
            <TtButton Variant="icon" OnClick="HearQuestion">🔊</TtButton>
        }
        else if (currentMode == QuizMode.Split)
        {
            <p class="quiz-question-text">@QuestionText</p>
            @* Splitshuisje: the whole on the roof, the two parts in the rooms *@
            <div class="split-house">
                <div class="split-roof"><span>@questionNum</span></div>
                <div class="split-rooms">
                    @foreach (var left in new[] { true, false })
                    {
                        var unknown = left == splitUnknownLeft;
                        <div class="split-room @(unknown && !solved ? "split-blank" : "") @(unknown && solved ? "split-solved" : "")">
                            @(unknown ? (solved ? targetNumber.ToString() : "?") : questionNum2.ToString())
                        </div>
                    }
                </div>
            </div>
            <TtButton Variant="icon" OnClick="HearQuestion">🔊</TtButton>
        }
        else
        {
            <p class="quiz-question-text">@QuestionText</p>
            <div class="quiz-sequence">
                @if (currentMode == QuizMode.Before)
                {
                    <div class="sequence-box seq-blank">?</div>
                    <div class="sequence-arrow">→</div>
                    <div class="sequence-box seq-given">@questionNum</div>
                }
                else if (currentMode == QuizMode.After)
                {
                    <div class="sequence-box seq-given">@questionNum</div>
                    <div class="sequence-arrow">→</div>
                    <div class="sequence-box seq-blank">?</div>
                }
                else if (currentMode == QuizMode.Tens)
                {
                    <div class="sequence-box seq-given">@questionNum</div>
                    <div class="sequence-arrow tens-jump">@(questionNum2 > 0 ? "+10" : "−10")</div>
                    <div class="sequence-box seq-blank">?</div>
                }
                else if (currentMode == QuizMode.Between)
                {
                    <div class="sequence-box seq-given">@questionNum</div>
                    <div class="sequence-arrow">→</div>
                    <div class="sequence-box seq-blank">?</div>
                    <div class="sequence-arrow">→</div>
                    <div class="sequence-box seq-given">@questionNum2</div>
                }
            </div>
            <TtButton Variant="icon"
                      OnClick="HearQuestion">🔊</TtButton>
        }
    </div>

    @* ── Choices ──────────────────────────────────────────────── *@
    <div class="quiz-choices">
        @foreach (var choice in choices)
        {
            var c = choice;
            var cls = (solved && c == targetNumber) ? "btn-correct"
                    : wrongAttempts.Contains(c) ? "btn-wrong"
                    : "btn-choice";
            var disabled = solved || wrongAttempts.Contains(c);
            <button class="btn quiz-btn @cls"
                    @onclick="() => Answer(c)"
                    disabled="@disabled">
                @c
            </button>
        }
    </div>

    @* ── Feedback + next row ──────────────────────────────────── *@
    @if (solved)
    {
        <div class="quiz-feedback feedback-correct">
            @Strings.QuizCorrect(Lang.Current)
            @NumberHelper.GetDisplayWord(targetNumber, Lang.Current)!
            <span class="quiz-stars-earned">+@lastStarsEarned ⭐</span>
        </div>

        <div class="quiz-next-row">
            <TtButton Variant="primary"
                      OnClick="NextQuestion">@Strings.QuizNext(Lang.Current)</TtButton>
            @if (autoAdvanceSeconds > 0 && countdownRemaining > 0)
            {
                <span class="countdown-badge">@countdownRemaining</span>
            }
        </div>
    }

    @* ── Score ────────────────────────────────────────────────── *@
    <div class="quiz-score">
        @Strings.QuizScore(Lang.Current): @score / @asked
        @if (streak >= 2)
        {
            <span class="quiz-streak">🔥 @streak</span>
        }
    </div>


@code {
    private enum QuizMode { Word, Before, After, Between, Count, Add, Subtract, MakeTen, Tens, Split }

    private static readonly QuizMode[] AllModes = Enum.GetValues<QuizMode>();
    private static readonly Random Rng = new();

    private static readonly (string Label, int Secs)[] DelayOptions =
        [("Off", 0), ("2s", 2), ("3s", 3), ("5s", 5)];

    // ── State ──────────────────────────────────────────────
    private HashSet<QuizMode> enabledModes = new(Enum.GetValues<QuizMode>());
    private QuizMode currentMode;
    private int targetNumber;
    private int questionNum;
    private int questionNum2;
    private List<int> choices = [];
    private bool solved;
    private HashSet<int> wrongAttempts = [];
    private int score;
    private int asked;
    private int streak;
    private int lastStarsEarned;

    // ── Automatic level ────────────────────────────────────
    // 1 = warm-up (to 20, counting dots, make 10) · 2 = to 50, sums to 20 crossing ten, jumps of 10
    // 3 = to 100, tens sums (30 + 40) · 4 = to 100, two-digit ± one-digit (47 − 3)
    // Five first-try answers in a row → up a level; two missed questions in a row → down a level.
    private const int MaxLevel = 4;
    private const int LevelUpRun = 5;
    private const int LevelDownRun = 2;
    private int level = 2;                 // a 6-year-old starts at level 2
    private int levelRun;                  // first-try answers in a row at this level
    private int missRun;                   // missed questions in a row
    private bool levelUpShown;
    private bool splitUnknownLeft;         // which room of the splitshuisje holds the "?"

    private static QuizMode[] LevelModes(int lvl) => lvl switch
    {
        1 => [QuizMode.Word, QuizMode.Before, QuizMode.After, QuizMode.Between,
              QuizMode.Count, QuizMode.Add, QuizMode.Subtract, QuizMode.MakeTen, QuizMode.Split],
        _ => [QuizMode.Word, QuizMode.Before, QuizMode.After, QuizMode.Between,
              QuizMode.Add, QuizMode.Subtract, QuizMode.Tens, QuizMode.Split],
    };

    // Highest number used in naming / ordering questions at this level.
    private int RangeMax => level switch { 1 => 20, 2 => 50, _ => NumberHelper.Max };
    // From level 3 the small numbers are known: practise 10–100.
    private int RangeMin => level >= 3 ? 10 : 1;

    // ── UI state ───────────────────────────────────────────
    private bool showSettings;

    // ── Auto-advance ───────────────────────────────────────
    private int autoAdvanceSeconds = 3;
    private int countdownRemaining;
    private CancellationTokenSource? _cts;

    // ── Lifecycle ──────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        Lang.OnChange += OnLanguageChanged;
        var saved = await JS.InvokeAsync<int>("getQuizLevel");
        if (saved is >= 1 and <= MaxLevel) level = saved;
        await NextQuestion();
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Lang.OnChange -= OnLanguageChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }

    // ── Computed ───────────────────────────────────────────
    private string ModeLabel(QuizMode m) => m switch
    {
        QuizMode.Word => Strings.QuizModeWord(Lang.Current),
        QuizMode.Before => Strings.QuizModeBefore(Lang.Current),
        QuizMode.After => Strings.QuizModeAfter(Lang.Current),
        QuizMode.Between => Strings.QuizModeBetween(Lang.Current),
        QuizMode.Count => Strings.QuizModeCount(Lang.Current),
        QuizMode.Add => Strings.QuizModeAdd(Lang.Current),
        QuizMode.Subtract => Strings.QuizModeSubtract(Lang.Current),
        QuizMode.MakeTen => Strings.QuizModeMakeTen(Lang.Current),
        QuizMode.Tens => Strings.QuizModeTens(Lang.Current),
        QuizMode.Split => Strings.QuizModeSplit(Lang.Current),
        _ => ""
    };

    private string QuestionText => currentMode switch
    {
        QuizMode.Before => Strings.QuizBefore(Lang.Current, questionNum),
        QuizMode.After => Strings.QuizAfter(Lang.Current, questionNum),
        QuizMode.Between => Strings.QuizBetween(Lang.Current, questionNum,
questionNum2),
        QuizMode.Count => Strings.QuizCountDots(Lang.Current),
        QuizMode.Add => Strings.QuizAdd(Lang.Current, questionNum, questionNum2),
        QuizMode.Subtract => Strings.QuizSubtract(Lang.Current, questionNum, questionNum2),
        QuizMode.MakeTen => Strings.QuizMakeTen(Lang.Current, questionNum),
        QuizMode.Tens => questionNum2 > 0 ? Strings.QuizTensMore(Lang.Current, questionNum)
                                          : Strings.QuizTensLess(Lang.Current, questionNum),
        QuizMode.Split => Strings.QuizSplit(Lang.Current, questionNum, questionNum2),
        _ => ""
    };

    // ── Mode toggling ──────────────────────────────────────
    void ToggleMode(QuizMode m)
    {
        if (enabledModes.Contains(m))
        {
            if (enabledModes.Count == 1) return; // keep at least one
            enabledModes.Remove(m);
        }
        else
        {
            enabledModes.Add(m);
        }
    }

    // ── Delay setting ──────────────────────────────────────
    void SetDelay(int secs) => autoAdvanceSeconds = secs;

    // Stars scale with the current first-try streak: 1–4 → 1, 5–9 → 2, 10–19 → 3, 20+ → 4.
    private static int StarsForStreak(int s) => s >= 20 ? 4 : s >= 10 ? 3 : s >= 5 ? 2 : 1;

    // ── Question generation ────────────────────────────────
    void NewQuestion()
    {
        CancelCountdown();
        solved = false;
        wrongAttempts = [];

        levelUpShown = false;

        // Pick a random mode that is both switched on and part of this level.
        var levelModes = LevelModes(level);
        var pool = enabledModes.Where(levelModes.Contains).ToArray();
        if (pool.Length == 0) pool = enabledModes.ToArray();     // parent's choice wins if nothing overlaps
        currentMode = pool[Rng.Next(pool.Length)];

        int lo = RangeMin, hi = RangeMax;
        switch (currentMode)
        {
            case QuizMode.Word:
                targetNumber = Rng.Next(lo, hi + 1);
                choices = GenerateChoices(targetNumber, 1, hi, Reversed(targetNumber));
                break;

            case QuizMode.Before:
                questionNum = Rng.Next(lo + 1, hi + 1);
                targetNumber = questionNum - 1;
                choices = GenerateChoices(targetNumber, 1, hi, null, questionNum);
                break;

            case QuizMode.After:
                questionNum = Rng.Next(lo, hi);
                targetNumber = questionNum + 1;
                choices = GenerateChoices(targetNumber, 1, hi, null, questionNum);
                break;

            case QuizMode.Between:
                targetNumber = Rng.Next(lo + 1, hi);
                questionNum = targetNumber - 1;
                questionNum2 = targetNumber + 1;
                choices = GenerateChoices(targetNumber, 1, hi, null, questionNum, questionNum2);
                break;

            case QuizMode.Count:
                targetNumber = Rng.Next(1, 21);
                choices = GenerateChoices(targetNumber, 1, 20);
                break;

            case QuizMode.Add:
                (questionNum, questionNum2) = MakeAddition();
                targetNumber = questionNum + questionNum2;
                choices = SumChoices(targetNumber, Math.Max(20, targetNumber + 10));
                break;

            case QuizMode.Subtract:
                (questionNum, questionNum2) = MakeSubtraction();
                targetNumber = questionNum - questionNum2;
                choices = SumChoices(targetNumber, questionNum);
                break;

            case QuizMode.MakeTen:
                questionNum = Rng.Next(1, 10);                  // given part 1–9
                targetNumber = 10 - questionNum;
                choices = GenerateChoices(targetNumber, 1, 9);
                break;

            case QuizMode.Split:
                (questionNum, questionNum2) = MakeSplit();      // whole, known part
                targetNumber = questionNum - questionNum2;
                splitUnknownLeft = Rng.Next(2) == 0;
                // Tempting: off by one, repeating the known part, and off by ten for big numbers.
                choices = PickChoices(targetNumber,
                    level >= 3 && questionNum > 20
                        ? [targetNumber + 10, targetNumber - 10, targetNumber + 1, targetNumber - 1, questionNum2]
                        : [targetNumber + 1, targetNumber - 1, questionNum2, targetNumber + 2, targetNumber - 2],
                    0, Math.Max(questionNum, 10));
                break;

            case QuizMode.Tens:
                bool more = level < 3 ? Rng.Next(3) > 0 : Rng.Next(2) == 0;   // mostly "+10" at first
                questionNum = more ? Rng.Next(1, hi - 9) : Rng.Next(11, hi + 1);
                questionNum2 = more ? 10 : -10;
                targetNumber = questionNum + questionNum2;
                // Tempting wrong answers: off by one, or jumped the wrong way / twice.
                choices = PickChoices(targetNumber,
                    [targetNumber + 1, targetNumber - 1, questionNum + 1, questionNum - 1,
                     targetNumber + 10, targetNumber - 10], 0, NumberHelper.Max, questionNum);
                break;
        }
    }

    // ── Sums per level ─────────────────────────────────────
    (int, int) MakeAddition()
    {
        switch (level)
        {
            case 1:                                           // within 10
            {
                int a = Rng.Next(1, 10);
                return (a, Rng.Next(1, 11 - a));
            }
            case 2:                                           // within 20, mostly crossing ten (8 + 5)
                return Rng.Next(10) < 6 ? CrossTenAdd() : AnyAddTo(20);
            case 3:                                           // crossing ten, or whole tens (30 + 40)
            {
                if (Rng.Next(2) == 0) return CrossTenAdd();
                int a = Rng.Next(1, 9);
                return (a * 10, Rng.Next(1, 10 - a) * 10);
            }
            default:                                          // two-digit + one-digit (34 + 5, 47 + 6)
            {
                int a = Rng.Next(11, 90);
                if (a % 10 == 0) a++;
                return (a, Rng.Next(1, Math.Min(9, 99 - a) + 1));
            }
        }
    }

    (int, int) MakeSubtraction()
    {
        switch (level)
        {
            case 1:                                           // within 10
            {
                int a = Rng.Next(2, 11);
                return (a, Rng.Next(1, a));
            }
            case 2:                                           // within 20, mostly crossing ten (13 − 6)
                return Rng.Next(10) < 6 ? CrossTenSub() : AnySubFrom(20);
            case 3:                                           // crossing ten, or whole tens (70 − 30)
            {
                if (Rng.Next(2) == 0) return CrossTenSub();
                int a = Rng.Next(2, 11);
                return (a * 10, Rng.Next(1, a) * 10);
            }
            default:                                          // two-digit − one-digit (47 − 3, 52 − 6)
            {
                int a = Rng.Next(21, 100);
                if (a % 10 == 0) a++;
                return (a, Rng.Next(1, 10));
            }
        }
    }

    // Splitshuisjes per level: (whole, known part).
    (int, int) MakeSplit()
    {
        switch (level)
        {
            case 1:                                           // split 5–10
            {
                int whole = Rng.Next(5, 11);
                return (whole, Rng.Next(1, whole));
            }
            case 2:                                           // split up to 20, both parts ≤ 10 (13 = 8 + 5)
                return SplitTo20();
            case 3:                                           // to 20, or whole tens (70 = 30 + 40)
            {
                if (Rng.Next(2) == 0) return SplitTo20();
                int k = Rng.Next(2, 11);
                return (k * 10, Rng.Next(1, k) * 10);
            }
            default:                                          // tens and ones (47 = 40 + 7), or whole tens
            {
                if (Rng.Next(3) == 0)
                {
                    int k = Rng.Next(2, 11);
                    return (k * 10, Rng.Next(1, k) * 10);
                }
                int whole = Rng.Next(21, 100);
                if (whole % 10 == 0) whole++;
                int tens = whole / 10 * 10;
                return (whole, Rng.Next(2) == 0 ? tens : whole - tens);
            }
        }
    }

    (int, int) SplitTo20()
    {
        int whole = Rng.Next(10) < 7 ? Rng.Next(11, 21) : Rng.Next(6, 11);
        int lo = Math.Max(1, whole - 10), hi = Math.Min(10, whole - 1);
        return (whole, Rng.Next(lo, hi + 1));
    }

    // a + b where the sum passes 10: 8 + 5, 7 + 6 …
    (int, int) CrossTenAdd()
    {
        int a = Rng.Next(2, 10);
        return (a, Rng.Next(11 - a, 10));
    }

    // a − b where you pass 10 going down: 13 − 6, 15 − 8 …
    (int, int) CrossTenSub()
    {
        int a = Rng.Next(11, 19);
        return (a, Rng.Next(a % 10 + 1, 10));
    }

    (int, int) AnyAddTo(int max)
    {
        int a = Rng.Next(1, max);
        return (a, Rng.Next(1, max + 1 - a));
    }

    (int, int) AnySubFrom(int max)
    {
        int a = Rng.Next(2, max + 1);
        return (a, Rng.Next(1, a));
    }

    // 47 ↔ 74: the classic Dutch mix-up ("zevenenveertig" says the 7 first).
    static int? Reversed(int n)
    {
        if (n < 12 || n > 99 || n % 10 == 0 || n % 11 == 0) return null;
        return n % 10 * 10 + n / 10;
    }

    // Sum answers: off by one or two, and from level 2 "forgot the ten" (7 + 5 = 2).
    // Off by +10 only once sums reach the tens (level 3+). Never below the bigger
    // addend for "+", so no silly options like 0 for 4 + 6.
    List<int> SumChoices(int correct, int max)
    {
        int[] tempting = level switch
        {
            1 => [correct + 1, correct - 1, correct + 2, correct - 2],
            2 => [correct + 1, correct - 1, correct - 10, correct + 2, correct - 2],
            _ => [correct + 1, correct - 1, correct + 10, correct - 10, correct + 2, correct - 2],
        };
        int min = currentMode == QuizMode.Add ? Math.Max(questionNum, questionNum2) : 0;
        return PickChoices(correct, tempting, min, Math.Max(max, min + 10));
    }

    List<int> PickChoices(int correct, int[] tempting, int min, int max, params int[] exclude)
    {
        var excluded = new HashSet<int>(exclude) { correct };
        var pool = new List<int> { correct };
        foreach (var c in tempting.Where(c => c >= min && c <= max && !excluded.Contains(c))
                                  .Distinct().OrderBy(_ => Rng.Next()))
        {
            if (pool.Count == 4) break;
            pool.Add(c);
        }
        if (pool.Count < 4)
            foreach (var c in GenerateChoices(correct, min, max, null, [.. exclude, .. pool]))
                if (pool.Count < 4 && !pool.Contains(c)) pool.Add(c);
        return pool.OrderBy(_ => Rng.Next()).ToList();
    }

    // `extra` is one hand-picked tempting answer to include when it's valid (e.g. 74 for 47).
    List<int> GenerateChoices(int correct, int min, int max, int? extra = null, params int[] exclude)
    {
        var excluded = new HashSet<int>(exclude) { correct };
        var pool = new HashSet<int> { correct };
        if (extra is int e && e >= min && e <= max && !excluded.Contains(e)) pool.Add(e);

        for (int attempt = 0; pool.Count < 4 && attempt < 200; attempt++)
        {
            int candidate = Math.Clamp(correct + Rng.Next(-5, 6), min, max);
            if (!excluded.Contains(candidate)) pool.Add(candidate);
        }

        for (int n = min; n <= max && pool.Count < 4; n++)
            if (!excluded.Contains(n)) pool.Add(n);

        return pool.OrderBy(_ => Rng.Next()).ToList();
    }

    // ── Speech ─────────────────────────────────────────────
    async Task HearQuestion()
    {
        var text = currentMode switch
        {
            QuizMode.Word => NumberHelper.GetSpeechWord(targetNumber, Lang.Current),
            QuizMode.Add => Strings.QuizAddSpeak(Lang.Current, questionNum, questionNum2),
            QuizMode.Subtract => Strings.QuizSubtractSpeak(Lang.Current, questionNum, questionNum2),
            _ => QuestionText
        };
        await JS.InvokeVoidAsync("speakNumber", text, Lang.LangCode);
    }

    // ── Answer handling ────────────────────────────────────
    async Task Answer(int choice)
    {
        await JS.InvokeVoidAsync("blurActive");
        if (choice == targetNumber)
        {
            solved = true;
            asked++;
            if (wrongAttempts.Count == 0) { score++; streak++; }
            lastStarsEarned = StarsForStreak(streak);
            await Stars.AddAsync(lastStarsEarned);
            var levelChange = await TrackLevel(firstTry: wrongAttempts.Count == 0);
            var feedback = Strings.SpeakCorrectFeedback(Lang.Current, wrongAttempts.Count,
streak);
            await JS.InvokeVoidAsync("speakNumber",
                feedback + NumberHelper.GetSpeechWord(targetNumber, Lang.Current)
                    + (levelChange > 0 ? ". " + Strings.QuizLevelUp(Lang.Current, level) : ""),
                Lang.LangCode);
            StartCountdown();
        }
        else
        {
            streak = 0;
            wrongAttempts.Add(choice);
            await JS.InvokeVoidAsync("speakNumber",
Strings.SpeakWrongFeedback(Lang.Current), Lang.LangCode);
        }
    }

    // Returns +1 on level up, −1 on level down, 0 otherwise.
    async Task<int> TrackLevel(bool firstTry)
    {
        int change = 0;
        if (firstTry)
        {
            missRun = 0;
            if (++levelRun >= LevelUpRun && level < MaxLevel) { level++; change = 1; }
        }
        else
        {
            levelRun = 0;
            if (++missRun >= LevelDownRun && level > 1) { level--; change = -1; }
        }

        if (change != 0)
        {
            levelRun = 0;
            missRun = 0;
            levelUpShown = change > 0;
            await JS.InvokeVoidAsync("saveQuizLevel", level);
        }
        return change;
    }

    async Task NextQuestion()
    {
        NewQuestion();
        await HearQuestion();
    }

    // ── Countdown ──────────────────────────────────────────
    void StartCountdown()
    {
        if (autoAdvanceSeconds <= 0) return;

        CancelCountdown();
        var cts = new CancellationTokenSource();
        _cts = cts;
        countdownRemaining = autoAdvanceSeconds;

        _ = RunCountdown(cts.Token);
    }

    async Task RunCountdown(CancellationToken token)
    {
        try
        {
            while (countdownRemaining > 0)
            {
                await Task.Delay(1000, token);
                countdownRemaining--;
                await InvokeAsync(StateHasChanged);
            }

            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(async () =>
                {
                    await NextQuestion();
                    StateHasChanged();
                });
            }
        }
        catch (TaskCanceledException) { }
    }

    void CancelCountdown()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
        countdownRemaining = 0;
    }
}
